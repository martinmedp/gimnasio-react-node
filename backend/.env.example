# Copia este archivo como ".env" y completa los valores.
# El archivo ".env" NUNCA se sube a git (contiene secretos).

# Conexión a MySQL. Formato: mysql://usuario:contrasena@servidor:puerto/base
# Si la contraseña tiene caracteres especiales (@ : / ?), se escriben codificados.
DATABASE_URL="mysql://root:@localhost:3306/gimnasio_db"

# Clave que firma las sesiones. OBLIGATORIA, mínimo 32 caracteres aleatorios.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si la cambias, todas las sesiones abiertas se cierran.
JWT_SECRET=

# Dirección del frontend, sin barra final (la usa CORS).
# En producción es obligatoria. Ejemplo: https://gimnasio.midominio.com
FRONTEND_URL=http://localhost:5173

# Puerto del servidor (opcional, por defecto 3000)
# PORT=3000

# Ruta de mysqldump para los respaldos (opcional).
# Por defecto: C:\xampp\mysql\bin\mysqldump.exe en Windows, "mysqldump" en Linux.
# MYSQLDUMP_PATH=

# Solo para crear el primer Administrador con el seed (se usan una vez):
# ADMIN_NOMBRE=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=