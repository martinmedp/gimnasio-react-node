generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
}

model Usuario {
  id                Int          @id @default(autoincrement())
  nombre            String
  email             String       @unique
  password          String
  rolId             Int
  rol               Rol          @relation(fields: [rolId], references: [id])
  clienteId         Int?         @unique
  cliente           Cliente?     @relation(fields: [clienteId], references: [id])
  activo            Boolean      @default(true)
  pagosRegistrados  Pago[]
  cierresRealizados CierreCaja[] // relación inversa: cierres de caja que este usuario realizó
}

model Cliente {
  id                Int              @id @default(autoincrement())
  nombre            String
  documento         String           @unique
  telefono          String?
  email             String?
  fechaNacimiento   DateTime?
  estatura          Float?
  fotoUrl           String?
  fechaInscripcion  DateTime         @default(now())
  estado            String           @default("activo")
  membresias        Membresia[]
  asistencias       Asistencia[]
  rutinas           Rutina[]
  medidasCorporales MedidaCorporal[]
  usuario           Usuario?
}

model Plan {
  id               Int         @id @default(autoincrement())
  nombre           String
  tipo             String
  precio           Decimal
  duracionDias     Int?
  cantidadEntradas Int?
  membresias       Membresia[]
}

model Membresia {
  id                Int       @id @default(autoincrement())
  clienteId         Int
  planId            Int
  fechaInicio       DateTime  @default(now())
  fechaFin          DateTime?
  entradasRestantes Int?
  estado            String    @default("activa")
  cliente           Cliente   @relation(fields: [clienteId], references: [id])
  plan              Plan      @relation(fields: [planId], references: [id])
  pagos             Pago[]
}

model Pago {
  id              Int       @id @default(autoincrement())
  membresiaId     Int
  monto           Decimal
  fecha           DateTime  @default(now())
  metodoPago      String
  registradoPorId Int
  registradoPor   Usuario   @relation(fields: [registradoPorId], references: [id])
  membresia       Membresia @relation(fields: [membresiaId], references: [id])

  // Nuevo: el cierre de caja que incluyó este pago. Es opcional porque
  // un pago recién registrado todavía no pertenece a ningún cierre
  // (null = "pendiente de cierre"; con valor = "ya cerrado")
  cierreCajaId Int?
  cierreCaja   CierreCaja? @relation(fields: [cierreCajaId], references: [id])
}

// Nuevo: registro de un cierre de caja. Guarda una "foto" fija de los
// totales del periodo, no se recalcula ni se modifica después de creado
model CierreCaja {
  id              Int      @id @default(autoincrement())
  fechaDesde      DateTime // inicio del periodo cerrado (inclusive)
  fechaHasta      DateTime // fin del periodo cerrado (inclusive)
  totalGeneral    Decimal // suma de TODOS los pagos del periodo, sin importar el método
  totalEfectivo   Decimal // suma solo de los pagos en efectivo (lo que debería haber en caja)
  efectivoContado Decimal // dinero que el personal contó físicamente
  diferencia      Decimal // efectivoContado - totalEfectivo (negativo = faltante, positivo = sobrante)
  observaciones   String?  @db.Text
  fechaCierre     DateTime @default(now()) // cuándo se realizó el cierre (distinto del periodo cerrado)
  cerradoPorId    Int
  cerradoPor      Usuario  @relation(fields: [cerradoPorId], references: [id])
  pagos           Pago[] // los pagos que quedaron incluidos en este cierre
}

model Asistencia {
  id        Int      @id @default(autoincrement())
  clienteId Int
  fecha     DateTime @default(now())
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
}

model MedidaCorporal {
  id                        Int      @id @default(autoincrement())
  clienteId                 Int
  fecha                     DateTime @default(now())
  peso                      Float?
  porcentajeGrasa           Float?
  circunferenciaPecho       Float?
  circunferenciaCintura     Float?
  circunferenciaCadera      Float?
  circunferenciaBrazo       Float?
  circunferenciaMuslo       Float?
  circunferenciaPantorrilla Float?
  circunferenciaCuello      Float?
  notas                     String?  @db.Text
  cliente                   Cliente  @relation(fields: [clienteId], references: [id])
}

model Entrenador {
  id           Int                 @id @default(autoincrement())
  nombre       String
  especialidad String?
  telefono     String?
  horarios     HorarioEntrenador[]
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model HorarioEntrenador {
  id           Int        @id @default(autoincrement())
  entrenadorId Int
  diaSemana    DiaSemana
  horaInicio   String
  horaFin      String
  entrenador   Entrenador @relation(fields: [entrenadorId], references: [id])
}

model SeccionCuerpo {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  ejercicios Ejercicio[]
}

model Ejercicio {
  id               Int               @id @default(autoincrement())
  nombre           String
  descripcion      String?           @db.Text
  imagenUrl        String?
  seccionCuerpoId  Int
  seccionCuerpo    SeccionCuerpo     @relation(fields: [seccionCuerpoId], references: [id])
  rutinaEjercicios RutinaEjercicio[]
}

model Rutina {
  id               Int               @id @default(autoincrement())
  clienteId        Int
  nombre           String
  diaSemana        DiaSemana
  fechaCreacion    DateTime          @default(now())
  cliente          Cliente           @relation(fields: [clienteId], references: [id])
  rutinaEjercicios RutinaEjercicio[]

  @@unique([clienteId, diaSemana])
}

model RutinaEjercicio {
  id           Int       @id @default(autoincrement())
  rutinaId     Int
  ejercicioId  Int
  series       Int
  repeticiones Int
  peso         String?
  orden        Int
  rutina       Rutina    @relation(fields: [rutinaId], references: [id])
  ejercicio    Ejercicio @relation(fields: [ejercicioId], references: [id])
}
