generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
}

model Usuario {
  id                     Int          @id @default(autoincrement())
  nombre                 String
  email                  String       @unique
  password               String
  rolId                  Int
  rol                    Rol          @relation(fields: [rolId], references: [id])
  clienteId              Int?         @unique
  cliente                Cliente?     @relation(fields: [clienteId], references: [id])
  activo                 Boolean      @default(true)
  pagosRegistrados       Pago[]       @relation("PagoRegistradoPor")
  pagosAnulados          Pago[]       @relation("PagoAnuladoPor") // pagos que este usuario anuló
  gastosRegistrados      Gasto[] // nuevo: relación inversa hacia los gastos que este usuario registró
  cierresRealizados      CierreCaja[] @relation("CierreCerradoPor")
  cierresRevertidos      CierreCaja[] @relation("CierreRevertidoPor")
  asistenciasAutorizadas Asistencia[] @relation("AsistenciaAutorizadaPor") // entradas forzadas que este usuario autorizó
  pagos                  Pago[]
}

model Cliente {
  id                Int              @id @default(autoincrement())
  nombre            String
  documento         String           @unique
  telefono          String?
  email             String?
  fechaNacimiento   DateTime?
  estatura          Float?
  fotoUrl           String?
  fechaInscripcion  DateTime         @default(now())
  estado            String           @default("activo")
  membresias        Membresia[]
  asistencias       Asistencia[]
  rutinas           Rutina[]
  medidasCorporales MedidaCorporal[]
  usuario           Usuario?
}

model Plan {
  id               Int         @id @default(autoincrement())
  nombre           String
  tipo             String
  precio           Decimal
  duracionDias     Int?
  cantidadEntradas Int?
  membresias       Membresia[]
}

model Membresia {
  id                Int       @id @default(autoincrement())
  clienteId         Int
  planId            Int
  fechaInicio       DateTime  @default(now())
  fechaFin          DateTime?
  entradasRestantes Int?
  estado            String    @default("activa")
  cliente           Cliente   @relation(fields: [clienteId], references: [id])
  plan              Plan      @relation(fields: [planId], references: [id])
  pagos             Pago[]
}

model Pago {
  id              Int         @id @default(autoincrement())
  membresiaId     Int
  monto           Decimal
  fecha           DateTime    @default(now())
  metodoPago      String
  registradoPorId Int
  // Ahora hay DOS relaciones entre Pago y Usuario (quién registró y quién
  // anuló), así que cada una necesita un nombre para que Prisma sepa a
  // cuál columna corresponde cada lado. Poner nombre a la existente no
  // cambia nada en la base de datos
  registradoPor   Usuario     @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id])
  membresia       Membresia   @relation(fields: [membresiaId], references: [id])
  cierreCajaId    Int?
  cierreCaja      CierreCaja? @relation(fields: [cierreCajaId], references: [id])

  // Anulación: el pago NO se borra, queda marcado. Los pagos anulados no
  // cuentan en totales, cierres ni reportes, pero siguen existiendo como
  // rastro de auditoría (quién, cuándo y por qué)
  anulado         Boolean   @default(false)
  anuladoEn       DateTime?
  anuladoPorId    Int?
  anuladoPor      Usuario?  @relation("PagoAnuladoPor", fields: [anuladoPorId], references: [id])
  motivoAnulacion String?   @db.Text
  usuario         Usuario?  @relation(fields: [usuarioId], references: [id])
  usuarioId       Int?
}

// Nuevo: catálogo de categorías de gasto, gestionable desde la app
// (mismo patrón que Plan: una tabla simple con CRUD propio)
model CategoriaGasto {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  gastos Gasto[]
}

// Nuevo: el registro de egresos — es el espejo de Pago, con la misma
// lógica de "pendiente/cerrado" vía cierreCajaId
model Gasto {
  id              Int            @id @default(autoincrement())
  categoriaId     Int
  categoria       CategoriaGasto @relation(fields: [categoriaId], references: [id])
  // Texto libre y largo (@db.Text, igual que descripcion de Ejercicio),
  // para anotar detalles como "Compra materiales, almacén XYZ, factura #123"
  descripcion     String         @db.Text
  monto           Decimal
  fecha           DateTime       @default(now())
  metodoPago      String
  registradoPorId Int
  registradoPor   Usuario        @relation(fields: [registradoPorId], references: [id])
  cierreCajaId    Int?
  cierreCaja      CierreCaja?    @relation(fields: [cierreCajaId], references: [id])
}

model CierreCaja {
  id                  Int      @id @default(autoincrement())
  fechaDesde          DateTime
  fechaHasta          DateTime
  totalGeneral        Decimal
  totalEfectivo       Decimal
  // Nuevos: totales de gastos del periodo, mismo concepto que
  // totalGeneral/totalEfectivo pero del lado de los egresos
  totalGastos         Decimal  @default(0)
  totalGastosEfectivo Decimal  @default(0)
  efectivoContado     Decimal
  diferencia          Decimal
  observaciones       String?  @db.Text
  fechaCierre         DateTime @default(now())
  cerradoPorId        Int
  cerradoPor          Usuario  @relation("CierreCerradoPor", fields: [cerradoPorId], references: [id])
  pagos               Pago[]
  gastos              Gasto[] // nuevo: los gastos que quedaron incluidos en este cierre

  revertido       Boolean   @default(false)
  revertidoEn     DateTime?
  revertidoPorId  Int?
  revertidoPor    Usuario?  @relation("CierreRevertidoPor", fields: [revertidoPorId], references: [id])
  motivoReversion String?   @db.Text
}

model Asistencia {
  id        Int      @id @default(autoincrement())
  clienteId Int
  fecha     DateTime @default(now())
  cliente   Cliente  @relation(fields: [clienteId], references: [id])

  // Entradas "forzadas": registradas aunque el sistema advirtió un problema
  // (membresía vencida, sin entradas, sin membresía o doble registro del
  // día) y el personal decidió confirmar igual. Quedan marcadas para poder
  // revisarlas después.
  forzada         Boolean  @default(false)
  // Qué advertencia se ignoró, por ejemplo "VENCIDA" o "YA_REGISTRO_HOY"
  motivoForzada   String?
  // Quién del personal autorizó la entrada
  autorizadaPorId Int?
  autorizadaPor   Usuario? @relation("AsistenciaAutorizadaPor", fields: [autorizadaPorId], references: [id])
}

model MedidaCorporal {
  id                        Int      @id @default(autoincrement())
  clienteId                 Int
  fecha                     DateTime @default(now())
  peso                      Float?
  porcentajeGrasa           Float?
  circunferenciaPecho       Float?
  circunferenciaCintura     Float?
  circunferenciaCadera      Float?
  circunferenciaBrazo       Float?
  circunferenciaMuslo       Float?
  circunferenciaPantorrilla Float?
  circunferenciaCuello      Float?
  notas                     String?  @db.Text
  cliente                   Cliente  @relation(fields: [clienteId], references: [id])
}

model Entrenador {
  id           Int                 @id @default(autoincrement())
  nombre       String
  especialidad String?
  telefono     String?
  horarios     HorarioEntrenador[]
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model HorarioEntrenador {
  id           Int        @id @default(autoincrement())
  entrenadorId Int
  diaSemana    DiaSemana
  horaInicio   String
  horaFin      String
  entrenador   Entrenador @relation(fields: [entrenadorId], references: [id])
}

model SeccionCuerpo {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  ejercicios Ejercicio[]
}

model Ejercicio {
  id               Int               @id @default(autoincrement())
  nombre           String
  descripcion      String?           @db.Text
  imagenUrl        String?
  seccionCuerpoId  Int
  seccionCuerpo    SeccionCuerpo     @relation(fields: [seccionCuerpoId], references: [id])
  rutinaEjercicios RutinaEjercicio[]
}

model Rutina {
  id               Int               @id @default(autoincrement())
  clienteId        Int
  nombre           String
  diaSemana        DiaSemana
  fechaCreacion    DateTime          @default(now())
  cliente          Cliente           @relation(fields: [clienteId], references: [id])
  rutinaEjercicios RutinaEjercicio[]

  @@unique([clienteId, diaSemana])
}

model RutinaEjercicio {
  id           Int       @id @default(autoincrement())
  rutinaId     Int
  ejercicioId  Int
  series       Int
  repeticiones Int
  peso         String?
  orden        Int
  rutina       Rutina    @relation(fields: [rutinaId], references: [id])
  ejercicio    Ejercicio @relation(fields: [ejercicioId], references: [id])
}
